# Log files
*.log

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

#docker
/[Dd]ocker*
!/[Dd]ocker-compose.yaml
!/[Dd]ockerfile
**/*.tar

#vscode
.vscode

#temp
**/tmp

#logs
logs/
*.log

# remove /pem file
# **/*.pem

**/_*.go
**/.*.go

# env file
**/*.env


*.db
messages.db.*
